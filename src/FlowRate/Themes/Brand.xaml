<?xml version="1.0" encoding="utf-8" ?>
<!--
    FlowRate brand system: centralized accent palette, gradient brushes,
    typography scale, and reusable card styling for the v0.4.0 visual overhaul.
    Merged into App.xaml so every view can reference these resources.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  ============ Brand Accent Palette ============  -->
    <Color x:Key="BrandBlue">#4285F4</Color>
    <Color x:Key="BrandCyan">#00C8DC</Color>
    <Color x:Key="BrandTeal">#06D6A0</Color>
    <Color x:Key="BrandGreen">#76E054</Color>
    <Color x:Key="BrandAmber">#FFD166</Color>
    <Color x:Key="BrandCoral">#FF6B6B</Color>

    <!--  Solid brand brushes  -->
    <SolidColorBrush x:Key="BrandBlueBrush" Color="{StaticResource BrandBlue}" />
    <SolidColorBrush x:Key="BrandCyanBrush" Color="{StaticResource BrandCyan}" />
    <SolidColorBrush x:Key="BrandTealBrush" Color="{StaticResource BrandTeal}" />
    <SolidColorBrush x:Key="BrandGreenBrush" Color="{StaticResource BrandGreen}" />
    <SolidColorBrush x:Key="BrandAmberBrush" Color="{StaticResource BrandAmber}" />
    <SolidColorBrush x:Key="BrandCoralBrush" Color="{StaticResource BrandCoral}" />

    <!--  ============ Signature Gradients ============  -->
    <!--  Primary action / hero accent: blue -> cyan -> teal sweep  -->
    <LinearGradientBrush x:Key="BrandAccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0.0" Color="{StaticResource BrandBlue}" />
        <GradientStop Offset="0.55" Color="{StaticResource BrandCyan}" />
        <GradientStop Offset="1.0" Color="{StaticResource BrandTeal}" />
    </LinearGradientBrush>

    <!--  Speed accent: teal -> green, used for "fast/good" emphasis  -->
    <LinearGradientBrush x:Key="BrandSpeedGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0.0" Color="{StaticResource BrandTeal}" />
        <GradientStop Offset="1.0" Color="{StaticResource BrandGreen}" />
    </LinearGradientBrush>

    <!--  Subtle glass tint for cards layered over Mica  -->
    <LinearGradientBrush x:Key="BrandCardGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.0" Color="#14FFFFFF" />
        <GradientStop Offset="1.0" Color="#05FFFFFF" />
    </LinearGradientBrush>

    <!--  ============ Typography Scale ============  -->
    <x:Double x:Key="BrandDisplaySize">40</x:Double>
    <x:Double x:Key="BrandTitleSize">28</x:Double>
    <x:Double x:Key="BrandSubtitleSize">18</x:Double>
    <x:Double x:Key="BrandBodySize">14</x:Double>
    <x:Double x:Key="BrandCaptionSize">12</x:Double>

    <Style x:Key="BrandDisplayText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource BrandDisplaySize}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LineHeight" Value="46" />
    </Style>

    <Style x:Key="BrandTitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource BrandTitleSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="BrandSubtitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource BrandSubtitleSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="BrandCaptionText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource BrandCaptionSize}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="CharacterSpacing" Value="40" />
    </Style>

    <!--  ============ Card Styling ============  -->
    <!--  Reusable "glass card" used across the results/metrics surfaces  -->
    <Style x:Key="BrandCard" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <!--  Elevated variant with a hairline accent-tinted stroke  -->
    <Style
        x:Key="BrandAccentCard"
        BasedOn="{StaticResource BrandCard}"
        TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
    </Style>

</ResourceDictionary>
