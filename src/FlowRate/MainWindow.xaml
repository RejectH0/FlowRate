<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="FlowRate.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:FlowRate"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:FlowRate.ViewModels"
    Title="FlowRate - Network Benchmark"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock
                FontSize="28"
                FontWeight="SemiBold"
                Text="FlowRate" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Network Benchmark Tool powered by iperf3" />
        </StackPanel>

        <!--  Configuration  -->
        <StackPanel Grid.Row="1" Spacing="12">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox
                    Grid.Column="0"
                    Header="Server Address"
                    PlaceholderText="e.g., 192.168.1.100 or server.local"
                    Text="{x:Bind ViewModel.ServerAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <NumberBox
                    Grid.Column="1"
                    Width="100"
                    Header="Port"
                    Maximum="65535"
                    Minimum="1"
                    SpinButtonPlacementMode="Compact"
                    Value="{x:Bind ViewModel.Port, Mode=TwoWay}" />
            </Grid>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <NumberBox
                    Grid.Column="0"
                    Header="Duration (seconds)"
                    Maximum="3600"
                    Minimum="1"
                    SpinButtonPlacementMode="Compact"
                    Value="{x:Bind ViewModel.DurationSeconds, Mode=TwoWay}" />

                <NumberBox
                    Grid.Column="1"
                    Header="Parallel Streams"
                    Maximum="128"
                    Minimum="1"
                    SpinButtonPlacementMode="Compact"
                    Value="{x:Bind ViewModel.ParallelStreams, Mode=TwoWay}" />
            </Grid>

            <CheckBox
                Content="Reverse Mode (server sends)"
                IsChecked="{x:Bind ViewModel.ReverseMode, Mode=TwoWay}" />

            <Button Command="{x:Bind ViewModel.RunBenchmarkCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ProgressRing
                        Width="16"
                        Height="16"
                        IsActive="{x:Bind ViewModel.IsRunning, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay}" />
                    <FontIcon
                        FontSize="16"
                        Glyph="&#xE768;" />
                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!--  Results  -->
        <ScrollViewer Grid.Row="2" Margin="0,24,0,0">
            <TextBlock
                FontFamily="Consolas"
                IsTextSelectionEnabled="True"
                Text="{x:Bind ViewModel.ResultSummary, Mode=OneWay}" />
        </ScrollViewer>
    </Grid>
</Window>
